{
  "name": "@frontend/vitest-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./node-package": {
      "types": "./node-package.d.ts",
      "default": "./node-package.mjs"
    },
    "./vue-app": {
      "types": "./vue-app.d.ts",
      "default": "./vue-app.mjs"
    }
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "lint": "eslint \"*.mjs\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json --noEmit"
  }
}
