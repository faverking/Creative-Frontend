{
  "name": "frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "dev:admin": "pnpm --filter admin-web dev",
    "dev:portal": "pnpm --filter portal-web dev",
    "dev:ai": "pnpm --filter ai-console dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "echo \"E2E tests are not configured yet. Add browser scenarios under tests/e2e when enabled.\"",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "prepare": "husky install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@frontend/eslint-config": "workspace:*",
    "@frontend/vitest-config": "workspace:*",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.0",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.18",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6"
  }
}
